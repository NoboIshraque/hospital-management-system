# Dependencies
node_modules/

# Environment / secrets — never commit these
.env
.env.*
!.env.example
*.pem

# Logs
*.log
npm-debug.log*
logs/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Local database dumps that aren't part of the deliverable
database/local-*.sql
database/*.bak

# Claude Code's local tool settings (preview server config) — per laptop
.claude/

# Database backups (npm run db:backup) hold patient data — never commit them
backups/

# Demo video recordings and frame grabs (large, regenerated by video/record.mjs)
video/out/

# The viva deck embeds the video; rebuild it with presentation/build-deck.js
presentation/out/
