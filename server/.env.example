# Copy this file to .env (same folder) and fill in your own values.
# .env is ignored by git, so your password never leaves your laptop.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-root-password
DB_NAME=uhid
# Any long random sentence. It signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-sentence
# APP_DB_USER / APP_DB_PASSWORD (the limited user the API connects as) are
# added at the bottom of .env automatically the first time you run
# npm run db:reset. You don't need to write them yourself.
# Only when the site is served over HTTPS: marks the session cookie secure
# and sends HSTS. Leave it out on http://localhost, or signing in stops working.
# COOKIE_SECURE=1
# Demo installation (the course): the sign-in page lists the demo accounts
# and their shared password. Leave it out on a real installation.
DEMO_MODE=1
