        <mxCell id="c6-l5" value="N" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;strokeColor=#47606D;fontSize=24;fontColor=#0E1B22;labelBackgroundColor=#FFFFFF;shape=link;" edge="1" parent="1" source="appointment" target="booked"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c6-note" value="There is no SLOT entity on this page, and that absence IS the design. A bookable slot is derived: schedule MINUS leave MINUS booked appointments. Storing slots instead would be roughly 27,000 mostly-empty rows that go stale the moment a clinic time changes. schedule and leave are both WEAK entities — a weekly clinic has no identity apart from the doctor whose clinic it is." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#47606D;fillColor=#FFFFFF;strokeColor=#D3DEE3;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="1545" width="1500" height="260" as="geometry"/></mxCell>
      </root>
