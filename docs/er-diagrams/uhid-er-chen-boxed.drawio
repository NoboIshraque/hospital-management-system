        <mxCell id="uhid_sequence.attrs" value="&lt;u&gt;year&lt;/u&gt;&lt;div&gt;last_serial&lt;/div&gt;" style="align=left;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;fontSize=24;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;" vertex="1" parent="uhid_sequence"><mxGeometry y="50" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="uhid_sequence.note" value="Stands alone: no relationship and no foreign key. register_patient() locks this year’s row to issue the next UHID serial." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#47606D;fillColor=#FFFFFF;strokeColor=#D3DEE3;spacing=10;" vertex="1" parent="1"><mxGeometry x="1300" y="290" width="520" height="130" as="geometry"/></mxCell>
