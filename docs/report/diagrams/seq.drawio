T INTO appointment; COMMIT (lock released)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="942" y="800" width="286" height="32" as="geometry"/></mxCell><mxCell id="e36" style="endArrow=open;endSize=8;dashed=1;html=1;strokeColor=#1A1A1A;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914" y="915" as="sourcePoint"/><mxPoint x="606" y="915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v37" value="appointment_id, slot_start, slot_end" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="622" y="887" width="276" height="17" as="geometry"/></mxCell><mxCell id="e38" style="endArrow=open;endSize=8;dashed=1;html=1;strokeColor=#1A1A1A;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="987" as="sourcePoint"/><mxPoint x="110" y="987" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v39" value="201 Created" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="352" y="959" width="226" height="17" as="geometry"/></mxCell><mxCell id="e40" style="endArrow=open;endSize=8;dashed=1;html=1;strokeColor=#4A3E9E;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="1059" as="sourcePoint"/><mxPoint x="938" y="1059" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v41" value="lock granted; overlapping bookings = 1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#4A3E9E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="942" y="1031" width="286" height="17" as="geometry"/></mxCell><mxCell id="e42" style="endArrow=open;endSize=8;dashed=1;html=1;strokeColor=#4A3E9E;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="926" y="1131" as="sourcePoint"/><mxPoint x="618" y="1131" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v43" value="SIGNAL 45000 'slot just taken'; ROLLBACK" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#4A3E9E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="622" y="1088" width="276" height="32" as="geometry"/></mxCell><mxCell id="e44" style="endArrow=open;endSize=8;dashed=1;html=1;strokeColor=#4A3E9E;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="606" y="1203" as="sourcePoint"/><mxPoint x="330" y="1203" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v45" value="409 Conflict + message" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#4A3E9E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="352" y="1175" width="226" height="17" as="geometry"/></mxCell><mxCell id="v46" value="Backstop: appointment has UNIQUE(doctor_id, slot_start). Even if the lock were missing, the second INSERT would fail with error 1062, which the procedure turns into the same message. Correctness comes from the constraint; the clean answer comes from the lock." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#96550A;align=left;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="560" y="1287" width="840" height="62" as="geometry"/></mxCell><mxCell id="v47" value="Black: request A · Purple: request B&lt;br&gt;Solid arrow: call · Dashed arrow: return" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#47606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1291" width="480" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>